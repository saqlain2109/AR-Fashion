# Database Connection URL:
# For Local Development / Render SQLite:
DATABASE_URL="file:./ar_fashion.db"

# For Production PostgreSQL (e.g., Neon.tech, Supabase, Render Postgres, Vercel Postgres):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/ar_fashion?sslmode=require"

# JWT Secret for Administrator Authentication Sessions (Generate a random 32+ char string)
JWT_SECRET="ar-fashion-house-super-secure-production-jwt-secret-key-2026"

# Node Environment
NODE_ENV="production"
